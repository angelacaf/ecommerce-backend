# Copia questo file in .env e modifica i valori

# Database - Sostituisci con le tue credenziali PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_db

# JWT - Genera una chiave sicura per produzione
# Usa: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters

# Token expiration (in minuti)
ACCESS_TOKEN_EXPIRE_MINUTES=200

# CORS - URL del frontend (separa con virgole)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Debug mode
DEBUG=True